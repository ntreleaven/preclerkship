 "nodes": [
  {
   "id": "root",
   "x": 402,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "WEAKNESS: loss of voluntary movement from a break anywhere, cerebrum to muscle fibre",
   "lines": [
    "first rule out mimics: incoordination (cerebellar) · apraxia (cortical) · severe sensory loss (proprioceptive failure)",
    "history: where (one limb, one side, both) · how (abrupt or gradual) · what is hard · sensory, speech or swallowing, pain, bowel or bladder"
   ]
  },
  {
   "id": "g_umn",
   "x": 45,
   "y": 156,
   "w": 474,
   "h": 114,
   "kind": "plain",
   "title": "UPPER MOTOR NEURON (UMN)",
   "lines": [
    "• spasticity · hyperreflexia",
    "• upgoing plantar (Babinski)",
    "• no atrophy · no fasciculations",
    "• PYRAMIDAL: arm extensors and leg flexors weak first"
   ]
  },
  {
   "id": "g_lmn",
   "x": 559,
   "y": 156,
   "w": 960,
   "h": 114,
   "kind": "plain",
   "title": "LOWER MOTOR NEURON (LMN)",
   "lines": [
    "• atrophy · fasciculations possible (anterior horn cell, nerve)",
    "• reflexes normal, ↓ or absent · tone normal · downgoing plantar",
    "• the pattern fits the level"
   ]
  },
