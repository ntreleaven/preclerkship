  {
   "id": "brain_pat_0_0",
   "x": 45,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "brain_t",
   "title": "Hemiparesis, pyramidal",
   "lines": [
    "• face, arm > leg → middle cerebral artery (MCA)",
    "• leg > face, arm → anterior cerebral artery (ACA)",
    "• face = arm = leg → internal capsule"
   ]
  },
  {
   "id": "stem_pat_0_0",
   "x": 207,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "stem_t",
   "title": "Hemiparesis, pyramidal",
   "lines": [
    "~less often all four limbs"
   ]
  },
  {
   "id": "cord_pat_0_0",
   "x": 369,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "cord_t",
   "title": "Paraparesis or quadriparesis",
   "lines": [
    "pyramidal, both sides below the lesion"
   ]
  },
  {
   "id": "ahc_pat_0_0",
   "x": 559,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "ahc_t",
   "title": "Segmental",
   "lines": [
    "~LMN pattern"
   ]
  },
  {
   "id": "root_pat_0_0",
   "x": 721,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "root_t",
   "title": "MYOTOMAL",
   "lines": [
    "• that root's reflex ↓",
    "• several roots: more than one level, sometimes both sides"
   ]
  },
  {
   "id": "plex_pat_0_0",
   "x": 883,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "plex_t",
   "title": "One limb",
   "lines": [
    "more muscles than one nerve or one root"
   ]
  },
  {
   "id": "nerve_pat_0_0",
   "x": 1045,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "nerve_t",
   "title": "One nerve, or many",
   "lines": [
    "• ONE nerve: that nerve's muscles (ulnar, radial, common peroneal, sciatic)",
    "• MANY (polyneuropathy): length-dependent, symmetric, DISTAL, feet first",
    "• or mononeuritis multiplex"
   ]
  },
  {
   "id": "nmj_pat_0_0",
   "x": 1207,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "nmj_t",
   "title": "FLUCTUATING, descending",
   "lines": [
    "eyes first (ptosis, diplopia) → speech, swallowing"
   ]
  },
  {
   "id": "muscle_pat_0_0",
   "x": 1369,
   "y": 452,
   "w": 150,
   "h": 278,
   "kind": "muscle_t",
   "title": "Symmetric PROXIMAL",
   "lines": [
    "trunk, paraspinals, shoulder and hip girdle"
   ]
  },
  {
   "id": "brain_clue_0_0",
   "x": 45,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "brain_w",
   "title": "Cortical signs",
   "lines": [
    "• aphasia, neglect",
    "• headache, seizures",
    "• sensory: potentially",
    "• no pain"
   ]
  },
  {
   "id": "stem_clue_0_0",
   "x": 207,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "stem_w",
   "title": "Cranial nerves",
   "lines": [
    "• diplopia, vertigo",
    "• cerebellar findings",
    "• CROSSED: face one side, body the other"
   ]
  },
  {
   "id": "cord_clue_0_0",
   "x": 369,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "cord_w",
   "title": "SENSORY LEVEL",
   "lines": [
    "• neck or back pain",
    "• urinary symptoms"
   ]
  },
  {
   "id": "ahc_clue_0_0",
   "x": 559,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "ahc_w",
   "title": "NO sensory loss",
   "lines": [
    "• no pain"
   ]
  },
  {
   "id": "root_clue_0_0",
   "x": 721,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "root_w",
   "title": "DERMATOMAL loss",
   "lines": [
    "• neck or back pain radiating into a limb"
   ]
  },
  {
   "id": "plex_clue_0_0",
   "x": 883,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "plex_w",
   "title": "Painful",
   "lines": [
    "• sensory usually"
   ]
  },
  {
   "id": "nerve_clue_0_0",
   "x": 1045,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "nerve_w",
   "title": "That nerve's area",
   "lines": [
    "or GLOVE AND STOCKING, prominent",
    "• pain +/-"
   ]
  },
  {
   "id": "nmj_clue_0_0",
   "x": 1207,
   "y": 770,
   "w": 150,
   "h": 132,
   "kind": "nmj_w",
   "title": "Sensation normal",
   "lines": [
