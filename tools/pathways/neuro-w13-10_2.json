   "title": "Language NORMAL",
   "lines": [
    "• naming, comprehension, repetition, fluency intact",
    "• any lost → APHASIA"
   ]
  },
  {
   "id": "cereb_look_0_0",
   "x": 1141,
   "y": 414,
   "w": 196,
   "h": 170,
   "kind": "cereb_t",
   "title": "Think alcohol intoxication",
   "lines": [
    "• nystagmus",
    "• dysarthria, dysphagia",
    "• finger-to-nose, heel-to-shin ataxia",
    "• rapid alternating movements",
    "• gait, tandem walking"
   ]
  },
  {
   "id": "cortex_where_0_0",
   "x": 45,
   "y": 624,
   "w": 196,
   "h": 260,
   "kind": "cortex_w",
   "title": "Middle cerebral artery (MCA): face + arm >> leg",
   "lines": [
    "• frontal → mostly motor",
    "• parietal → mostly sensory",
    "• no speech, follows commands, right face + arm weak → LEFT frontal lobe"
   ]
  },
  {
   "id": "subcortex_where_0_0",
   "x": 253,
   "y": 624,
   "w": 196,
   "h": 260,
   "kind": "subcortex_w",
   "title": "Internal capsule",
   "lines": [
    "motor AND sensory both possible"
   ]
  },
  {
   "id": "stem_where_0_0",
   "x": 461,
   "y": 624,
   "w": 196,
   "h": 260,
   "kind": "stem_w",
   "title": "With weakness",
