   ]
  },
  {
   "id": "dys_where_0_0",
   "x": 933,
   "y": 624,
   "w": 196,
   "h": 260,
   "kind": "dys_w",
   "title": "Anywhere on the speech path",
   "lines": [
    "• CNS: cortex (mouth area), subcortex, thalamus, brainstem, cerebellum",
    "• PNS: nerve (recurrent laryngeal), neuromuscular junction (myasthenia), muscle",
    "• the company decides: cranial nerves, UMN or LMN, weakness, ataxia, sensory"
   ]
  },
  {
