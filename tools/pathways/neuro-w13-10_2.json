   "kind": "legs_t",
   "title": "Could be any of",
   "lines": [
    "• parasagittal cortex (meningioma)",
    "• spinal cord",
    "• anterior horn cell",
    "• multilevel lumbosacral roots (stenosis)",
    "• polyneuropathy · myopathy"
   ]
  },
  {
   "id": "dys_look_0_0",
