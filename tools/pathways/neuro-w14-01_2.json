   "y": 778,
   "w": 206,
   "h": 170,
   "kind": "conc_w",
   "title": "CLINICAL diagnosis",
   "lines": [
    "no CT, MRI, blood test or EEG · SCAT5: 1 of 22 symptoms"
   ]
  },
  {
   "id": "edh_tx_0_0",
   "x": 45,
   "y": 988,
   "w": 206,
   "h": 152,
   "kind": "bad",
   "title": "CRANIOTOMY if ANY",
   "lines": [
    "• symptomatic",
    "• asymptomatic over 1 cm",
    "• a child",
    "~ conservative only if very small"
   ]
  },
  {
   "id": "sdh_tx_0_0",
   "x": 263,
   "y": 988,
   "w": 206,
   "h": 152,
   "kind": "bad",
   "title": "SURGERY within 4 HOURS",
   "lines": [
    "• within 4 h: 30% mortality",
    "• after 4 h: 90%",
    "• over 65: 82% mortality"
   ]
  },
