 "nodes": [
  {
   "id": "root",
   "x": 327,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Head injury: a TRAUMA patient first",
   "lines": [
    "A airway + C-spine precautions · B breathing · C circulation: large-bore IV, bloods for coagulopathy · D disability: neurological exam + Glasgow Coma Scale (GCS) · E expose other injuries",
    "GCS grades it: SEVERE 3-8 · MODERATE 9-12 · MILD 13-14 · MINOR 15"
   ]
  },
  {
   "id": "g_sev",
   "x": 45,
   "y": 156,
   "w": 1078,
   "h": 60,
   "kind": "plain",
   "title": "SEVERE traumatic brain injury",
   "lines": [
    "edema, vasodilation, vascular congestion, hematoma → ↑ intracranial pressure → HERNIATION"
   ]
  },
  {
   "id": "g_mild",
   "x": 1163,
   "y": 156,
   "w": 206,
   "h": 60,
   "kind": "plain",
   "title": "CONCUSSION",
   "lines": [
    "= mild traumatic brain injury"
   ]
  },
  {
   "id": "p_sev",
   "x": 45,
   "y": 256,
   "w": 1078,
   "h": 132,
   "kind": "info",
   "title": "Herniating? Act, then a STAT CT",
   "lines": [
    "• UNCAL: same-side fixed dilated pupil (third nerve) + opposite-side weakness",
    "• TONSILLAR: medulla compressed → Cushing's triad (hypertension, bradycardia, apnea) · fatal",
    "• intubate · head of the bed up · IV mannitol or 3% saline"
   ]
  },
  {
   "id": "p_mild",
   "x": 1163,
   "y": 256,
   "w": 206,
   "h": 132,
   "kind": "info",
   "title": "To the ER if ANY",
   "lines": [
    "• GCS under 15 · worsening mental status",
    "• possible spinal injury",
    "• worse symptoms, new neuro signs"
   ]
  },
  {
   "id": "edh_head_0_0",
   "x": 45,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "edh_h",
   "title": "Epidural hematoma",
   "lines": [
    "skull ↔ dura",
    "middle meningeal ARTERY"
   ]
  },
  {
   "id": "sdh_head_0_0",
   "x": 263,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "sdh_h",
   "title": "Acute subdural hematoma",
   "lines": [
    "dura ↔ arachnoid",
    "torn BRIDGING VEINS"
   ]
  },
  {
   "id": "cont_head_0_0",
   "x": 481,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "cont_h",
   "title": "Cerebral contusion",
   "lines": [
    "COUP under the impact",
    "CONTRECOUP opposite it"
   ]
  },
  {
   "id": "ich_head_0_0",
   "x": 699,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "ich_h",
   "title": "Intracerebral hemorrhage",
   "lines": [
    "deceleration or contact",
    "frontal, temporal lobes"
   ]
  },
  {
   "id": "dai_head_0_0",
   "x": 917,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "dai_h",
   "title": "Diffuse axonal injury · traumatic SAH",
   "lines": [
    "ACCELERATION injury",
    "often co-exist"
   ]
  },
  {
   "id": "conc_head_0_0",
   "x": 1163,
   "y": 468,
   "w": 206,
   "h": 114,
   "kind": "conc_h",
   "title": "Concussion",
   "lines": [
    "rotational acceleration · NO impact needed",
    "81-92% no LOC · helmets don't prevent it"
   ]
  },
  {
   "id": "edh_clue_0_0",
   "x": 45,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "edh_t",
   "title": "CONTACT injury + fracture",
   "lines": [
    "• LOC → LUCID interval → coma",
    "• skull fracture in 75-90%"
   ]
  },
  {
   "id": "sdh_clue_0_0",
   "x": 263,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "sdh_t",
   "title": "Acceleration-deceleration",
   "lines": [
    "• a fall, head strikes a broad surface",
    "• comatose from the scene"
   ]
  },
  {
   "id": "cont_clue_0_0",
   "x": 481,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "cont_t",
   "title": "Depends on size and site",
   "lines": [
    "• e.g. confusion, personality change, loss of smell",
    "• mass effect, ↑ pressure"
   ]
  },
  {
   "id": "ich_clue_0_0",
   "x": 699,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "ich_t",
   "title": "A confluent bleed in the brain",
   "lines": [
    "• blood dissects the brain around it"
   ]
  },
  {
   "id": "dai_clue_0_0",
   "x": 917,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "dai_t",
   "title": "LOC at the scene → PERSISTENT coma",
   "lines": [
    "• axonal injury is 50% of severe brain injury"
   ]
  },
  {
   "id": "conc_clue_0_0",
   "x": 1163,
   "y": 622,
   "w": 206,
   "h": 116,
   "kind": "conc_t",
   "title": "No focal deficit",
   "lines": [
    "• headache, dizziness, nausea",
    "• imbalance, 'seeing stars'"
   ]
  },
  {
   "id": "edh_inv_0_0",
   "x": 45,
   "y": 778,
   "w": 206,
   "h": 170,
   "kind": "edh_w",
   "title": "LENS-shaped",
   "lines": [
    "frontal or temporal"
   ]
  },
  {
   "id": "sdh_inv_0_0",
   "x": 263,
   "y": 778,
   "w": 206,
   "h": 170,
   "kind": "sdh_w",
   "title": "CRESCENT-shaped",
   "lines": [
    "often with diffuse axonal injury"
   ]
  },
  {
   "id": "cont_inv_0_0",
   "x": 481,
   "y": 778,
   "w": 206,
   "h": 170,
   "kind": "cont_w",
   "title": "MIXED high + low density",
   "lines": [
    "usually several · repeat CT at 24-48 h: 20% bleed later"
   ]
  },
  {
   "id": "ich_inv_0_0",
   "x": 699,
   "y": 778,
   "w": 206,
   "h": 170,
   "kind": "ich_w",
   "title": "HOMOGENEOUS, well-defined",
   "lines": [
    "hyperdense"
   ]
  },
  {
   "id": "dai_inv_0_0",
   "x": 917.0,
   "y": 778,
   "w": 98.0,
   "h": 170,
   "kind": "dai_w",
   "title": "Axonal: petechiae",
   "lines": [
    "grey-white junction, corpus callosum, pons · hard to see"
   ]
  },
  {
   "id": "dai_inv_0_1",
   "x": 1025.0,
