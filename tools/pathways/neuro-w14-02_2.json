 "nodes": [
  {
   "id": "root",
   "x": 100,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Could it be MULTIPLE SCLEROSIS (MS)?",
   "lines": [
    "an immune attack (B and T cells) on central nervous system myelin → axonal damage, then loss",
    "most common disabling neurological disease of young adults in Canada · women 3:1 · age 20-40",
    "risk: Epstein-Barr virus (EBV, 32-fold) · adolescent obesity · smoking · low vitamin D or sunlight · shift work"
   ]
  },
  {
   "id": "g_rel",
   "x": 45,
   "y": 156,
   "w": 870,
   "h": 78,
   "kind": "plain",
   "title": "A RELAPSE: which kind?",
   "lines": [
    "NEW neurological symptoms · acute or subacute onset · lasting 24 HOURS or more · no other cause · not a pseudo-relapse",
    "other features: sensory disturbances · fatigue · Lhermitte's sign (an electric shock down the back on bending the neck)"
   ]
  },
  {
   "id": "mye_head_0_0",
   "x": 45,
   "y": 314,
   "w": 282,
   "h": 60,
   "kind": "mye_h",
   "title": "Myelitis",
   "lines": [
    "spinal cord lesion · about 50% at onset"
   ]
  },
  {
   "id": "on_head_0_0",
   "x": 339,
   "y": 314,
   "w": 282,
   "h": 60,
   "kind": "on_h",
   "title": "Optic neuritis",
   "lines": [
    "about 25% at onset"
   ]
  },
  {
   "id": "bs_head_0_0",
   "x": 633,
   "y": 314,
   "w": 282,
   "h": 60,
   "kind": "bs_h",
   "title": "Brainstem or cerebellar syndrome",
   "lines": [
    "about 15% at onset"
   ]
  },
  {
   "id": "mye_clue_0_0",
   "x": 45,
   "y": 414,
   "w": 282,
   "h": 96,
   "kind": "mye_t",
   "title": "Below the lesion",
   "lines": [
    "• sensory changes",
    "• weakness",
    "• bladder and bowel dysfunction"
   ]
  },
  {
   "id": "on_clue_0_0",
   "x": 339,
   "y": 414,
   "w": 282,
   "h": 96,
   "kind": "on_t",
   "title": "Vision",
   "lines": [
    "• vision loss",
    "• PAIN with eye movement"
   ]
  },
  {
   "id": "bs_clue_0_0",
   "x": 633,
   "y": 414,
   "w": 282,
   "h": 96,
   "kind": "bs_t",
   "title": "Eyes and balance",
   "lines": [
    "• double vision · vertigo",
    "• ataxia · slurred speech (dysarthria)"
   ]
  },
  {
   "id": "span0_inv_0_0",
   "x": 45,
   "y": 550,
   "w": 870,
   "h": 60,
   "kind": "plain",
   "title": "MRI is central · lumbar puncture supports",
   "lines": [
    "2017 McDonald criteria: clinical attacks + MRI or CSF findings, combined"
   ]
  },
  {
   "id": "span0_inv_1_0",
   "x": 45.0,
   "y": 632,
   "w": 430.0,
   "h": 96,
   "kind": "warn",
   "title": "Disseminated in SPACE",
   "lines": [
    "lesions in 2 or more typical regions:",
    "• periventricular · cortical or juxtacortical",
    "• infratentorial · spinal cord"
   ]
  },
  {
   "id": "span0_inv_1_1",
   "x": 485.0,
   "y": 632,
   "w": 430.0,
   "h": 96,
   "kind": "warn",
   "title": "Disseminated in TIME",
   "lines": [
    "• a NEW lesion on follow-up MRI",
    "• OR enhancing + non-enhancing lesions at once",
    "• CSF oligoclonal bands can stand in for time"
   ]
  },
  {
   "id": "span0_inv_2_0",
   "x": 45,
   "y": 750,
   "w": 870,
   "h": 60,
   "kind": "bad",
   "title": "ALWAYS rule out a better explanation",
   "lines": [
    "neuromyelitis optica (NMO) · myelin oligodendrocyte glycoprotein disease (MOGAD) · vascular · infection · metabolic (B12)"
   ]
  },
  {
   "id": "span1_tx_0_0",
   "x": 45,
   "y": 850,
   "w": 870,
   "h": 60,
   "kind": "plain",
   "title": "Course: relapsing-remitting (85% at onset) → secondary progressive · or primary progressive from the start",
   "lines": [
    "score disability on the Expanded Disability Status Scale (EDSS, 0-10)"
   ]
  },
  {
   "id": "span1_tx_1_0",
   "x": 45.0,
   "y": 932,
   "w": 430.0,
   "h": 132,
   "kind": "ok",
   "title": "Disease-modifying therapy: think in CATEGORIES",
   "lines": [
    "• injectable platforms: interferons, glatiramer (Copaxone)",
    "• standard orals: dimethyl fumarate, teriflunomide, fingolimod",
    "• induction: cladribine",
    "• high efficacy: natalizumab, B-cell therapies (ocrelizumab, ofatumumab, rituximab)"
   ]
  },
  {
   "id": "span1_tx_1_1",
   "x": 485.0,
   "y": 932,
   "w": 430.0,
   "h": 132,
   "kind": "ok",
   "title": "Treat the symptoms too",
   "lines": [
    "• spasticity: baclofen, tizanidine",
    "• pain, tingling: amitriptyline, gabapentin, duloxetine",
    "• bladder: solifenacin · erections: sildenafil",
    "• fatigue: amantadine, modafinil · walking: fampridine"
   ]
  }
