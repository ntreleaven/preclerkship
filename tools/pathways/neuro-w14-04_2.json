   "title": "Numbness and tingling: WHERE is the lesion?",
   "lines": [
    "first: CENTRAL or PERIPHERAL?",
    "characterize a neuropathy: sensory, motor or autonomic · acute (days-6 weeks), subacute (to 6 months) or chronic · its pattern · axonal or demyelinating (EMG)"
   ]
  },
  {
   "id": "g_cns",
   "x": 45,
   "y": 156,
   "w": 436,
   "h": 60,
   "kind": "plain",
   "title": "CENTRAL",
   "lines": [
    "cortex · subcortical · brainstem · spinal cord"
   ]
  },
  {
   "id": "g_pns",
   "x": 521,
   "y": 156,
   "w": 884,
   "h": 60,
   "kind": "plain",
   "title": "PERIPHERAL",
   "lines": [
    "dorsal root ganglion · root · one nerve · many nerves"
   ]
  },
