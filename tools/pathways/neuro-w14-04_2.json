    "acute inflammatory demyelinating polyneuropathy"
   ]
  },
  {
   "id": "thal_clue_0_0",
   "x": 45,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "thal_t",
   "title": "The OPPOSITE side",
   "lines": [
    "• a clumsy hand",
    "• burning pain"
   ]
  },
  {
   "id": "cord_clue_0_0",
   "x": 269,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "cord_t",
   "title": "Below a level on the trunk",
   "lines": [
    "• tingling from mid-chest down",
    "• bladder urgency"
   ]
  },
  {
   "id": "root_clue_0_0",
   "x": 521,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "root_t",
   "title": "Back pain down one leg",
   "lines": [
    "• SHOOTING pain",
    "• S1: little toe and sole"
   ]
  },
  {
   "id": "mono_clue_0_0",
   "x": 745,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "mono_t",
   "title": "One nerve's territory",
   "lines": [
    "• hands: intermittent, NOCTURNAL",
    "• relieved by shaking the hands"
   ]
  },
  {
   "id": "poly_clue_0_0",
   "x": 969,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "poly_t",
   "title": "Distal, symmetric, years",
   "lines": [
    "• painful, BURNING feet (stocking-glove)",
    "• autonomic: postural light-headedness, urinary hesitancy, constipation"
   ]
  },
  {
   "id": "gbs_clue_0_0",
   "x": 1193,
   "y": 434,
   "w": 212,
   "h": 132,
   "kind": "gbs_t",
   "title": "ASCENDING over DAYS",
   "lines": [
    "• after an infection (a cold)",
    "• toes → knees, then fingertips → legs give out"
   ]
  },
  {
   "id": "thal_inv_0_0",
   "x": 45,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "thal_w",
   "title": "Not neglect or atrophy",
   "lines": [
    "neglect = cortex · atrophy = nerve"
   ]
  },
  {
   "id": "cord_inv_0_0",
   "x": 269,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "cord_w",
   "title": "A TRUNCAL SENSORY LEVEL",
   "lines": [
    "• BRISK reflexes below it",
    "• Babinski signs · Romberg can be positive"
   ]
  },
  {
   "id": "root_inv_0_0",
   "x": 521,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "root_w",
   "title": "One root's pattern",
   "lines": [
    "• S1: ABSENT ankle (Achilles) reflex"
   ]
  },
  {
   "id": "mono_inv_0_0",
   "x": 745,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "mono_w",
   "title": "Exam can be NORMAL",
   "lines": [
    "it is not MS"
   ]
  },
  {
   "id": "poly_inv_0_0",
   "x": 969,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "poly_w",
   "title": "Axonal, sensorimotor",
   "lines": [
    "large and small fibres · distal dying back"
   ]
  },
  {
   "id": "gbs_inv_0_0",
   "x": 1193,
   "y": 606,
   "w": 212,
   "h": 116,
   "kind": "gbs_w",
   "title": "WEAKNESS >> sensory loss",
   "lines": [
    "• AREFLEXIA, down-going toes",
    "• EMG: demyelinating (some axonal)"
   ]
  },
  {
   "id": "thal_tx_0_0",
   "x": 45,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "warn",
   "title": "Expect it as he recovers",
   "lines": [
    "central pain: see the NEUROPATHIC PAIN chart"
   ]
  },
  {
   "id": "cord_tx_0_0",
   "x": 269,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "warn",
   "title": "MRI of the cord",
   "lines": [
    "suspect MS? brain AND spinal cord, within 6 weeks"
   ]
  },
  {
   "id": "root_tx_0_0",
   "x": 521,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "warn",
   "title": "Not a diabetic neuropathy",
   "lines": [
    "shooting leg pain is a root, even in a diabetic"
   ]
  },
  {
   "id": "mono_tx_0_0",
   "x": 745,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "ok",
   "title": "Reassure · no imaging",
   "lines": [
    "nocturnal wrist splints"
   ]
  },
  {
   "id": "poly_tx_0_0",
   "x": 969,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "ok",
   "title": "Treat the PAIN",
   "lines": [
    "an analgesic or an antidepressant for neuropathic pain"
   ]
  },
  {
   "id": "gbs_tx_0_0",
   "x": 1193,
   "y": 762,
   "w": 212,
   "h": 96,
   "kind": "bad",
   "title": "IVIG · a neurologist",
   "lines": [
    "can reach the cranial nerves and breathing muscles → intubation"
   ]
  }
 ],
