 "nodes": [
  {
   "id": "root",
   "x": 252,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "NEUROPATHIC pain: a neurological cause, peripheral or central",
   "lines": [
    "sounds like: electrical · shooting · burning, hot or cold · pins and needles",
    "allodynia: a non-painful touch hurts · hyperpathia: a painful stimulus hurts far too much · dysesthesia: uncomfortable sensations (burning)",
    "EVALUATE THE CAUSE and examine: some are reversible · nociceptive pain (tissue injury) takes acetaminophen, NSAIDs, opioids instead"
   ]
  },
  {
   "id": "g_ad",
   "x": 45,
   "y": 192,
   "w": 440,
   "h": 60,
   "kind": "plain",
   "title": "ANTIDEPRESSANTS",
   "lines": [
    "↑ norepinephrine and serotonin → stronger descending pain inhibition"
   ]
  },
  {
   "id": "g_ac",
   "x": 525,
   "y": 192,
   "w": 440,
   "h": 60,
