   ]
  },
  {
   "id": "iih_head_0_0",
   "x": 837,
   "y": 350,
   "w": 186,
   "h": 98,
   "kind": "iih_h",
   "title": "Idiopathic intracranial hypertension",
   "lines": [
    "obesity · steroids · vitamin A · tetracycline"
   ]
  },
  {
   "id": "mig_head_0_0",
   "x": 1063,
   "y": 350,
   "w": 186,
   "h": 98,
   "kind": "mig_h",
   "title": "Migraine",
   "lines": [
    "prodrome · aura (25-30%) · headache · postdrome"
   ]
  },
  {
   "id": "tth_head_0_0",
   "x": 1261,
   "y": 350,
   "w": 186,
   "h": 98,
   "kind": "tth_h",
   "title": "Tension-type",
   "lines": [
    "the most prevalent"
   ]
  },
  {
   "id": "clu_head_0_0",
   "x": 1459,
   "y": 350,
   "w": 186,
   "h": 98,
   "kind": "clu_h",
   "title": "Cluster",
   "lines": [
    "men 3:1 · ~30 · smokers · alcohol"
   ]
  },
  {
   "id": "sah_clue_0_0",
   "x": 45,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "sah_t",
   "title": "THUNDERCLAP",
   "lines": [
    "• worst ever, peaks in seconds",
    "• vomiting, photophobia, stiff neck"
   ]
  },
  {
   "id": "men_clue_0_0",
   "x": 243,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "men_t",
   "title": "Fever + stiff neck",
   "lines": [
    "• photophobia",
    "• confused, hard to wake",
    "• Kernig, Brudzinski signs"
   ]
  },
  {
   "id": "gca_clue_0_0",
   "x": 441,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "gca_t",
   "title": "NEW temporal headache",
   "lines": [
    "• scalp tenderness · jaw claudication",
    "• transient vision loss",
    "• polymyalgic symptoms"
   ]
  },
  {
   "id": "tum_clue_0_0",
   "x": 639,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "tum_t",
   "title": "PROGRESSIVE, worse on waking",
   "lines": [
    "• vomiting · worse with cough, position",
    "• personality change, seizure, focal deficit"
   ]
  },
  {
   "id": "iih_clue_0_0",
   "x": 837,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "iih_t",
   "title": "Worse LYING flat, coughing",
   "lines": [
    "• whooshing (pulsatile) tinnitus",
    "• vision greys out for seconds",
    "• double vision (6th nerve)"
   ]
  },
  {
   "id": "mig_clue_0_0",
   "x": 1063,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "mig_t",
   "title": "ONE side, PULSATING",
   "lines": [
    "• 4-72 h · moderate-severe",
    "• worse with activity",
    "• nausea · light AND sound sensitivity"
   ]
  },
  {
   "id": "tth_clue_0_0",
   "x": 1261,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "tth_t",
   "title": "BOTH sides, PRESSING",
   "lines": [
    "• 30 min-7 days · mild-moderate",
    "• not worse with activity"
   ]
  },
  {
   "id": "clu_clue_0_0",
   "x": 1459,
   "y": 488,
   "w": 186,
   "h": 170,
   "kind": "clu_t",
   "title": "STRICTLY one side, at the eye",
   "lines": [
    "• severe · 15-180 min, up to 8 a day",
    "• same-side tearing, red eye, runny nose, ptosis",
    "• RESTLESS, paces · same time of day or year"
   ]
  },
  {
   "id": "sah_inv_0_0",
   "x": 45,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "sah_w",
   "title": "Urgent NON-CONTRAST CT",
   "lines": [
    "• sensitivity 98% day 0 → 50% at 1 week",
    "• negative → LP for xanthochromia"
   ]
  },
  {
   "id": "men_inv_0_0",
   "x": 243,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "men_w",
   "title": "Blood cultures · LP if safe",
   "lines": [
    "image first if signs of raised pressure"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 441,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "gca_w",
   "title": "ESR + CRP",
   "lines": [
    "• temporal artery biopsy or ultrasound",
    "• can be normal: patchy"
   ]
  },
  {
   "id": "tum_inv_0_0",
   "x": 639,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "tum_w",
   "title": "Urgent MRI with contrast",
   "lines": [
    "• (CT if no MRI) · papilledema = raised pressure",
    "• CT chest, abdomen, pelvis: primary or secondary?"
   ]
  },
  {
   "id": "iih_inv_0_0",
   "x": 837,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "iih_w",
   "title": "MRI + MR venogram FIRST",
   "lines": [
    "• then LP: opening pressure over 250 mm H2O"
   ]
  },
  {
   "id": "mig_inv_0_0",
   "x": 1063,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "mig_w",
   "title": "5-4-3-2-1",
   "lines": [
    "5 attacks · 4-72 h (4 hours to 3 days) · 2 of 4 features · 1 of nausea or light + sound"
   ]
  },
  {
   "id": "tth_inv_0_0",
   "x": 1261,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "tth_w",
   "title": "NO nausea or vomiting",
   "lines": [
    "at most one of light or sound sensitivity"
   ]
  },
  {
   "id": "clu_inv_0_0",
   "x": 1459,
   "y": 698,
   "w": 186,
   "h": 170,
   "kind": "clu_w",
   "title": "A trigeminal autonomic cephalalgia",
   "lines": [
    "the hypothalamus drives it"
   ]
  },
  {
   "id": "sah_tx_0_0",
   "x": 45,
   "y": 908,
   "w": 186,
   "h": 306,
   "kind": "bad",
   "title": "Secure the aneurysm",
   "lines": [
    "see the STROKE chart",
    "untreated, it re-bleeds: 15% in 24 h, 40% in a month"
   ]
  },
  {
   "id": "men_tx_0_0",
   "x": 243,
   "y": 908,
   "w": 186,
   "h": 306,
   "kind": "bad",
   "title": "IV antibiotics NOW",
   "lines": [
    "• ceftriaxone + vancomycin",
    "• ± ampicillin: elderly, immunocompromised",
    "• ± acyclovir: HSV",
    "• never wait for imaging or LP"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 441,
   "y": 908,
   "w": 186,
   "h": 306,
   "kind": "bad",
   "title": "HIGH-DOSE steroids TODAY",
   "lines": [
    "don't wait for the biopsy · untreated → permanent vision loss"
   ]
  },
  {
   "id": "tum_tx_0_0",
   "x": 639,
   "y": 908,
   "w": 186,
   "h": 306,
   "kind": "warn",
   "title": "Usual remedies fail",
   "lines": [
    "the headache does not respond"
   ]
  },
  {
   "id": "iih_tx_0_0",
   "x": 837,
   "y": 908,
   "w": 186,
   "h": 306,
   "kind": "ok",
   "title": "Weight loss + acetazolamide",
   "lines": [
    "• topiramate · shunt, optic nerve sheath fenestration",
    "• close eye follow-up"
   ]
  },
  {
   "id": "mig_tx_0_0",
   "x": 1063,
   "y": 908,
   "w": 186,
   "h": 132,
   "kind": "ok",
   "title": "ACUTE: treat EARLY",
   "lines": [
    "• NSAID ± triptan ± antiemetic",
    "• no triptan with coronary or cerebrovascular disease",
    "• under 2-3 days a week"
   ]
  },
  {
   "id": "mig_tx_1_0",
   "x": 1063,
   "y": 1062,
   "w": 186,
   "h": 152,
   "kind": "warn",
   "title": "PREVENT if over 4 a month or disabling",
   "lines": [
    "• first: beta-blocker or amitriptyline",
    "• high BMI: topiramate",
    "• chronic: onabotulinumtoxinA"
   ]
  },
  {
   "id": "tth_tx_0_0",
   "x": 1261,
   "y": 908,
   "w": 186,
   "h": 142,
   "kind": "ok",
   "title": "ACUTE",
   "lines": [
    "acetaminophen · ibuprofen · naproxen"
   ]
  },
  {
   "id": "tth_tx_1_0",
   "x": 1261,
   "y": 1072,
   "w": 186,
   "h": 142,
   "kind": "warn",
   "title": "PREVENT",
   "lines": [
    "amitriptyline · mirtazapine · venlafaxine · tizanidine"
   ]
  },
  {
   "id": "clu_tx_0_0",
   "x": 1459,
   "y": 908,
   "w": 186,
   "h": 142,
   "kind": "ok",
   "title": "ACUTE",
   "lines": [
    "• 100% oxygen 12-15 L/min for 15 min",
    "• sumatriptan 6 mg under the skin"
   ]
  },
  {
   "id": "clu_tx_1_0",
   "x": 1459,
   "y": 1072,
   "w": 186,
   "h": 142,
   "kind": "warn",
   "title": "PREVENT",
   "lines": [
    "• verapamil first · lithium · topiramate",
    "• bridge: prednisone, nerve block"
   ]
  }
 ],
