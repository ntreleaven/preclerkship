 "nodes": [
  {
   "id": "root",
   "x": 465,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Headache: rule OUT a secondary cause while you name the primary one",
   "lines": [
    "SNOOP4 red flags: Systemic (fever, weight loss) · Neurological deficits · Older onset (over 50) · Onset sudden (thunderclap) · Papilledema · Positional · Precipitated by Valsalva · Progressive or a new pattern",
    "examine: vital signs · fundi (papilledema) · pupils, eye movements, visual fields · neurological exam · body habitus · neck · scalp · jaw joint"
   ]
  },
  {
   "id": "g_sec",
   "x": 45,
   "y": 174,
   "w": 978,
   "h": 96,
   "kind": "plain",
   "title": "SECONDARY: a red flag",
   "lines": [
    "can be life-threatening"
   ]
  },
  {
   "id": "g_pri",
   "x": 1063,
   "y": 174,
   "w": 582,
   "h": 96,
   "kind": "plain",
   "title": "PRIMARY: no red flag",
   "lines": [
    "name it by its International Classification of Headache Disorders (ICHD-3) features",
    "beware medication overuse: triptans 10+ days, simple analgesics 15+ days a month, for over 3 months"
   ]
  },
  {
