   "y": 606,
   "w": 200,
   "h": 186,
   "kind": "bd_w",
   "title": "Nothing above the cord",
   "lines": [
    "• deep coma, no motor response (spinal reflexes allowed)",
    "• NO pupil (mid-size or larger), corneal, vestibulo-ocular, gag, cough",
    "• APNEA test: no breathing effort"
   ]
  },
  {
   "id": "coma_exam_0_0",
   "x": 257,
   "y": 606,
   "w": 200,
   "h": 186,
   "kind": "coma_w",
   "title": "Primitive reflexes only",
   "lines": [
    "• decorticate: arms FLEX, legs extend → above the red nucleus",
    "• decerebrate: all EXTEND → below the red nucleus",
    "• GCS ≤ 8 = severe brain injury"
   ]
  },
  {
   "id": "vs_exam_0_0",
   "x": 469,
   "y": 606,
   "w": 200,
   "h": 186,
   "kind": "vs_w",
   "title": "Reflexive, never purposeful",
   "lines": [
    "• grimace, yawn, roving eyes, flexion withdrawal",
    "• brief, UNSUSTAINED pursuit only",
    "• no words, no commands"
   ]
  },
  {
   "id": "mcsm_exam_0_0",
   "x": 709,
   "y": 606,
   "w": 200,
   "h": 186,
   "kind": "mcsm_w",
   "title": "Responds, but NO commands",
   "lines": [
    "• visual pursuit",
    "• localizes pain",
    "• smiles or cries to stimuli"
   ]
  },
  {
   "id": "mcsp_exam_0_0",
