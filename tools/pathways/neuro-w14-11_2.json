   "title": "Uncomfortable, not very sick",
   "lines": [
    "• headache, fever, photophobia, rash",
    "• MILD meningeal signs",
    "• neuro exam normal"
   ]
  },
  {
   "id": "hsv_clue_0_0",
   "x": 649,
   "y": 532,
   "w": 290,
   "h": 114,
   "kind": "hsv_t",
   "title": "Cortical signs",
   "lines": [
    "• LANGUAGE trouble (word salad), confusion",
    "• focal seizures, impaired memory, focal deficits",
    "• fever, ↓ awareness · usually NO stiff neck"
   ]
  },
  {
   "id": "bac_csf_0_0",
   "x": 45,
   "y": 686,
   "w": 290,
   "h": 132,
   "kind": "bac_w",
   "title": "Cloudy, PUS",
   "lines": [
    "• ↑ pressure",
    "• white cells > 500, NEUTROPHILS",
    "• protein HIGH · glucose LOW (CSF:serum < 0.3-0.4)",
    "• Gram stain POSITIVE"
   ]
  },
  {
   "id": "bac_csf_1_0",
   "x": 45,
   "y": 840,
   "w": 290,
   "h": 132,
   "kind": "bac_w",
   "title": "Organisms",
   "lines": [
    "• adults: S. pneumoniae, N. meningitidis, H. influenzae",
    "• > 50 or immunocompromised: LISTERIA",
    "• neonates: E. coli, group B strep",
    "• after surgery: Staphylococcus"
   ]
  },
  {
   "id": "asep_csf_0_0",
   "x": 347,
   "y": 686,
   "w": 290,
   "h": 286,
   "kind": "asep_w",
   "title": "Clear",
   "lines": [
    "• pressure normal or mildly ↑",
    "• white cells ↑ but < 1000, LYMPHOCYTES",
    "• protein mildly ↑ · glucose NORMAL",
    "• Gram stain negative"
   ]
  },
  {
   "id": "hsv_csf_0_0",
   "x": 649,
   "y": 686,
   "w": 290,
   "h": 286,
   "kind": "hsv_w",
   "title": "Lymphocytes, red cells, glucose normal",
   "lines": [
    "• CONFIRM: CSF HSV PCR",
    "• MRI: temporal lobe signal change",
    "• EEG: temporal spikes"
   ]
  },
  {
   "id": "bac_tx_0_0",
   "x": 45,
   "y": 1012,
   "w": 290,
   "h": 132,
   "kind": "ok",
   "title": "Empiric, IV",
   "lines": [
    "• CEFTRIAXONE 2 g q12h",
    "• + VANCOMYCIN 1 g q8h",
    "• + AMPICILLIN 2 g q4h if > 50 or immunocompromised",
    "• + ACYCLOVIR 10 mg/kg q8h (herpes)"
   ]
  },
