   "title": "SHORT history",
   "lines": [
    "weeks to a few months"
   ]
  },
  {
   "id": "lgg_pres_0_0",
   "x": 569,
   "y": 550,
   "w": 236,
   "h": 96,
   "kind": "lgg_t",
   "title": "LONG history",
   "lines": [
    "• months or longer",
    "• may be seizures only"
   ]
  },
  {
   "id": "pcl_pres_0_0",
   "x": 817,
   "y": 550,
   "w": 236,
   "h": 96,
   "kind": "pcl_t",
   "title": "Who gets it?",
   "lines": [
    "• HIV, immunosuppressed",
    "• also immunocompetent people",
    "• B-cell non-Hodgkin in 90%"
   ]
  },
  {
   "id": "met_tx_0_0",
   "x": 45,
   "y": 686,
   "w": 236,
   "h": 252,
   "kind": "ok",
   "title": "Accessible + causing symptoms",
   "lines": [
    "1 · resection (biopsy only if difficult)",
    "2 · then radiation: whole-brain or stereotactic radiosurgery",
    "3 · treat the primary cancer too"
   ]
  },
  {
   "id": "hgg_tx_0_0",
   "x": 321,
   "y": 686,
   "w": 236,
   "h": 252,
   "kind": "bad",
   "title": "TREAT IMMEDIATELY",
   "lines": [
    "1 · maximal safe resection (deep → stereotactic biopsy)",
    "2 · radiation, 15-30 treatments",
    "3 · temozolomide (oral) during and 6-12 months after",
    "~ glioblastoma: median survival 14-18 months"
   ]
  },
  {
   "id": "lgg_tx_0_0",
   "x": 569,
   "y": 686,
   "w": 236,
   "h": 80,
   "kind": "ok",
   "title": "No symptoms or seizures controlled",
   "lines": [
    "serial MRI · biopsy deferred"
   ]
  },
  {
   "id": "lgg_tx_1_0",
   "x": 569,
   "y": 788,
   "w": 236,
   "h": 150,
   "kind": "warn",
   "title": "TREAT if ANY of these",
   "lines": [
    "• new or progressive symptoms",
    "• clear progression on MRI (starts to enhance)",
    "• patient preference · older, very large",
    "→ biopsy or resection, then radiation"
   ]
  },
