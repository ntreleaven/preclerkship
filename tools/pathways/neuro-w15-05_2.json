   "w": 582,
   "kind": "dark",
   "title": "Floppy infant: UNSTABLE? → ABCDE first",
   "lines": [
    "hypotonia = less resistance to PASSIVE stretch · NOT the same as weakness",
    "Dextrose: check glucose, treat hypoglycemia NOW · Expose: injury or bleeding",
    "acute onset: most often INFECTION · always consider non-accidental trauma"
   ]
  },
  {
   "id": "g",
   "x": 45,
   "y": 156,
   "w": 612,
   "h": 78,
   "kind": "plain",
   "title": "Stable: confirm LOW TONE, then CENTRAL or PERIPHERAL?",
   "lines": [
    "vertical suspension: slips through your hands · horizontal: drapes in a U",
    "pull to sit: big head lag (normal head lag gone by 2-6 months)"
   ]
  },
  {
   "id": "cen_head_0_0",
   "x": 45,
   "y": 314,
   "w": 300,
   "h": 60,
   "kind": "cen_h",
   "title": "Central hypotonia",
   "lines": [
    "most common in NEWBORNS"
   ]
  },
  {
   "id": "per_head_0_0",
   "x": 357,
   "y": 314,
   "w": 300,
   "h": 60,
   "kind": "per_h",
   "title": "Peripheral hypotonia",
   "lines": [
    "motor neuron · junction · muscle"
   ]
  },
  {
   "id": "cen_pres_0_0",
   "x": 45,
   "y": 414,
   "w": 300,
   "h": 150,
   "kind": "cen_t",
   "title": "Brain is affected",
   "lines": [
    "• ↓ level of consciousness",
    "• GLOBAL developmental delay",
    "• NORMAL strength",
    "• NORMAL or BRISK reflexes, ± clonus",
    "• primitive reflexes persist",
    "• dysmorphic features (trisomy 21)"
   ]
  },
  {
   "id": "per_pres_0_0",
   "x": 357,
   "y": 414,
   "w": 300,
   "h": 150,
   "kind": "per_t",
   "title": "ALERT, but WEAK",
   "lines": [
    "• normal speech and cognition",
    "• delayed gross + fine MOTOR only",
    "• can't lift limbs against gravity",
    "• ↓ or ABSENT reflexes",
    "• facial weakness: feeding, breathing trouble"
   ]
  },
  {
   "id": "cen_cause_0_0",
   "x": 45,
   "y": 604,
   "w": 300,
   "h": 132,
   "kind": "cen_w",
   "title": "Central causes",
   "lines": [
    "• AT BIRTH: hypoxic-ischemic encephalopathy, trisomy 21, Prader-Willi",
    "• AFTER DAY 1: metabolic disorder",
    "• infection: sepsis, meningitis, herpes simplex, TORCH"
   ]
  },
  {
   "id": "per_cause_0_0",
   "x": 357,
   "y": 604,
   "w": 300,
   "h": 132,
   "kind": "per_w",
   "title": "By site",
   "lines": [
    "• motor neuron: spinal muscular atrophy",
    "• junction: congenital myasthenic syndrome, infant botulism",
    "• drug: aminoglycosides",
    "• muscle: congenital muscular dystrophy"
   ]
  },
  {
   "id": "cen_inv_0_0",
   "x": 45,
   "y": 776,
   "w": 300,
   "h": 114,
   "kind": "cen_w",
   "title": "Brain + blood",
   "lines": [
    "• CT or MRI of the brain",
    "• electrolytes, TSH, AMMONIA, metabolic tests",
    "• karyotype, genetic tests"
   ]
  },
  {
   "id": "per_inv_0_0",
   "x": 357,
