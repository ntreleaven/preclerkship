 "nodes": [
  {
   "id": "root",
   "x": 96,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Child seizing: ABCDE + time it",
   "lines": [
    "EVERY child: bedside GLUCOSE + blood GAS with electrolytes",
    "low glucose → IV dextrose (D10 5 mL/kg) · low sodium → 3% saline 3-5 mL/kg",
    "subtle in newborns: lip smacking, eye deviation, bicycling, apnea, vital sign changes"
   ]
  },
  {
   "id": "g_feb",
   "x": 45,
   "y": 156,
   "w": 552,
   "h": 96,
   "kind": "plain",
   "title": "FEVER, age 6 months-5 years: FEBRILE seizure",
   "lines": [
    "only if NO CNS infection, NO acute electrolyte problem, NO past afebrile seizure",
    "WORRY: not back to baseline · meningeal signs or toxic look · delay or neurologic condition"
   ]
  },
  {
   "id": "g_se",
   "x": 637,
   "y": 156,
   "w": 270,
   "h": 96,
   "kind": "plain",
   "title": "Still seizing at 5 MINUTES",
   "lines": [
    "or no return to baseline between seizures"
   ]
  },
  {
