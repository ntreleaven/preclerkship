   "y": 332,
   "w": 270,
   "h": 60,
   "kind": "cse_h",
   "title": "Convulsive status epilepticus",
   "lines": [
    "> 30 min, or 2+ seizures without recovery"
   ]
  },
  {
   "id": "sfs_pres_0_0",
   "x": 45,
   "y": 432,
   "w": 270,
   "h": 132,
   "kind": "sfs_t",
   "title": "Typical",
   "lines": [
    "• GENERALIZED",
    "• < 15 minutes",
    "• ONCE in 24 hours",
    "• no neurologic or developmental problem"
   ]
  },
  {
   "id": "cfs_pres_0_0",
   "x": 327,
   "y": 432,
   "w": 270,
   "h": 132,
   "kind": "cfs_t",
   "title": "Any ONE of",
   "lines": [
    "• FOCAL (one limb or side)",
    "• > 15 minutes",
    "• RECURS within 24 hours",
    "• focal signs after the seizure",
    "• known neurologic condition"
   ]
  },
  {
   "id": "cse_pres_0_0",
   "x": 637,
   "y": 432,
   "w": 270,
   "h": 132,
   "kind": "cse_t",
   "title": "Tonic-clonic, not stopping",
   "lines": [
    "• most seizures stop within 5 minutes",
    "• longer = more brain injury: time matters"
   ]
  },
  {
   "id": "sfs_inv_0_0",
   "x": 45,
   "y": 604,
   "w": 270,
   "h": 150,
   "kind": "sfs_w",
   "title": "Often NO further workup",
   "lines": [
    "if back to baseline, no other concern"
   ]
  },
  {
   "id": "cfs_inv_0_0",
   "x": 327,
   "y": 604,
   "w": 270,
   "h": 150,
   "kind": "cfs_w",
   "title": "Observe or admit",
   "lines": [
    "by time back to baseline, neurologic signs, family comfort"
   ]
  },
  {
   "id": "cse_inv_0_0",
   "x": 637,
   "y": 604,
   "w": 270,
   "h": 150,
   "kind": "cse_w",
   "title": "Stepwise, by the differential",
   "lines": [
    "• calcium, magnesium, drug levels",
    "• infection: blood count, CRP, cultures, CSF if stable",
    "• head CT: head injury, focal signs, raised pressure",
    "• EEG: subtle or non-convulsive"
   ]
  },
  {
   "id": "sfs_tx_0_0",
   "x": 45,
   "y": 794,
   "w": 270,
   "h": 332,
   "kind": "ok",
   "title": "Discharge + reassure",
   "lines": [
    "• recurrence 30-40%",
    "• epilepsy risk < 2%"
   ]
  },
  {
   "id": "cfs_tx_0_0",
   "x": 327,
   "y": 794,
   "w": 270,
   "h": 332,
   "kind": "warn",
   "title": "Consider NEUROLOGY referral",
   "lines": [
    "counsel: can recur and become epilepsy"
   ]
  },
  {
   "id": "cse_tx_0_0",
   "x": 637,
   "y": 794,
   "w": 270,
   "h": 114,
   "kind": "ok",
   "title": "1 · BENZODIAZEPINE",
   "lines": [
    "• IV lorazepam or midazolam",
    "• no IV access: sublingual lorazepam or intranasal midazolam",
    "• repeat every 3-5 min, 2-3 doses"
   ]
  },
  {
   "id": "cse_tx_1_0",
   "x": 637,
   "y": 930,
   "w": 270,
   "h": 114,
   "kind": "warn",
   "title": "2 · Second-line IV load",
   "lines": [
    "~given over 20-30 minutes",
    "• LEVETIRACETAM (most used)",
    "• PHENOBARBITAL if < 30 days old",
    "• or phenytoin / fosphenytoin"
   ]
  },
  {
   "id": "cse_tx_2_0",
   "x": 637,
   "y": 1066,
   "w": 270,
   "h": 60,
   "kind": "bad",
   "title": "3 · Refractory → ICU",
   "lines": [
    "benzodiazepine infusion · ketamine"
   ]
  }
