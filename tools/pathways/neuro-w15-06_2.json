   ]
  },
  {
   "id": "gca_pres_0_0",
   "x": 253,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "gca_t",
   "title": "Older + new headache",
   "lines": [
    "• jaw claudication",
    "• scalp tenderness",
    "• weight loss, polymyalgia rheumatica"
   ]
  },
  {
   "id": "on_pres_0_0",
   "x": 461,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "on_t",
   "title": "Healthy YOUNG woman",
   "lines": [
    "• sudden, painless",
    "• acuity reduced"
   ]
  },
  {
   "id": "rd_pres_0_0",
   "x": 669,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "rd_t",
   "title": "Flashes, floaters, curtain",
   "lines": [
    "• floaters = blood from a retinal tear",
    "• peripheral field loss",
    "• acuity may be normal"
   ]
  },
  {
   "id": "vh_pres_0_0",
   "x": 877,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "vh_t",
   "title": "Long-standing diabetes",
   "lines": [
    "• acuity: hand motion",
    "• pressure normal"
   ]
  },
  {
   "id": "gl_pres_0_0",
   "x": 1113,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "gl_t",
   "title": "SILENT until very late",
   "lines": [
    "• peripheral field goes first",
    "• acuity falls LAST"
   ]
  },
  {
   "id": "cat_pres_0_0",
   "x": 1321,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "cat_t",
   "title": "Hazy vision, glare",
   "lines": [
    "• halos, night driving",
    "• 'second sight': better near vision"
   ]
  },
  {
   "id": "amd_pres_0_0",
   "x": 1529,
   "y": 434,
   "w": 196,
   "h": 134,
   "kind": "amd_t",
   "title": "Central loss + distortion",
   "lines": [
    "• metamorphopsia: Amsler grid",
    "• wet: sudden severe drop"
   ]
  },
  {
   "id": "crao_inv_0_0",
   "x": 45,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "crao_w",
   "title": "RAPD + retina",
   "lines": [
    "• WHITE opacified retina",
    "• CHERRY-RED macular spot"
   ]
  },
  {
   "id": "gca_inv_0_0",
   "x": 253,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "gca_w",
   "title": "RAPD + SWOLLEN disc",
   "lines": [
    "• flame-shaped hemorrhages",
    "• ESR + CRP NOW (ESR usually > 60)"
   ]
  },
  {
   "id": "on_inv_0_0",
   "x": 461,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "on_w",
   "title": "RAPD + SWOLLEN disc",
   "lines": [
    "• clear media, clear red reflex",
    "• normal front of the eye"
   ]
  },
  {
   "id": "rd_inv_0_0",
   "x": 669,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "rd_w",
   "title": "Red reflex",
   "lines": [
    "• dark mobile spots",
    "~usually not seen with a direct ophthalmoscope"
   ]
  },
  {
   "id": "vh_inv_0_0",
   "x": 877,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "vh_w",
   "title": "Proliferative retinopathy",
   "lines": [
    "fragile new vessels bleed into the vitreous"
   ]
  },
  {
   "id": "gl_inv_0_0",
   "x": 1113,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "gl_w",
   "title": "Pressure + disc + field",
   "lines": [
    "• pressure > 21 (normal 10-21; can be normal)",
    "• cup-to-disc ≥ 0.5, or eyes differ > 0.2",
    "• arcuate defect, nasal step"
   ]
  },
  {
   "id": "cat_inv_0_0",
   "x": 1321,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "cat_w",
   "title": "Acuity ↓, hazy view",
   "lines": [
    "• dense: dull red reflex or white pupil",
    "• pressure normal"
   ]
  },
  {
   "id": "amd_inv_0_0",
   "x": 1529,
   "y": 608,
   "w": 196,
   "h": 132,
   "kind": "amd_w",
   "title": "Refer if ANY",
   "lines": [
    "• central acuity ↓",
    "• new distortion",
    "• drusen or blood at the macula"
   ]
  },
  {
   "id": "crao_tx_0_0",
   "x": 45,
   "y": 780,
   "w": 196,
   "h": 105,
   "kind": "bad",
   "title": "Ocular massage NOW",
   "lines": [
    "• heel of hand: 10 s press, 10 s release, for 5 min",
    "• EMERGENT referral"
   ]
  },
  {
   "id": "crao_tx_1_0",
   "x": 45,
   "y": 907,
   "w": 196,
   "h": 87,
   "kind": "warn",
   "title": "Find the source",
   "lines": [
    "carotid atheroma, heart valves"
   ]
  },
  {
   "id": "gca_tx_0_0",
   "x": 253,
   "y": 780,
   "w": 196,
   "h": 132,
   "kind": "bad",
   "title": "Steroids NOW",
   "lines": [
    "• visual symptoms: IV methylprednisolone 1 g × 3 days",
    "• none: prednisone 40-60 mg daily"
   ]
  },
  {
   "id": "gca_tx_1_0",
   "x": 253,
   "y": 934,
   "w": 196,
   "h": 60,
   "kind": "warn",
   "title": "EMERGENT referral",
   "lines": [
    "temporal artery biopsy"
   ]
  },
  {
   "id": "on_tx_0_0",
   "x": 461,
   "y": 780,
   "w": 196,
   "h": 214,
   "kind": "ok",
   "title": "Consult",
   "lines": [
    "• neuro-ophthalmology",
    "• MRI, possible IV corticosteroids",
    "• neurology: rule out multiple sclerosis"
   ]
  },
  {
   "id": "rd_tx_0_0",
   "x": 669,
   "y": 780,
   "w": 196,
   "h": 214,
   "kind": "warn",
   "title": "Refer promptly",
   "lines": [
    "ophthalmology evaluation"
   ]
  },
  {
   "id": "vh_tx_0_0",
   "x": 877,
   "y": 780,
   "w": 196,
   "h": 214,
   "kind": "ok",
   "title": "Retina specialist",
   "lines": [
    "pan-retinal laser photocoagulation"
   ]
  },
  {
   "id": "gl_tx_0_0",
   "x": 1113,
   "y": 780,
   "w": 196,
   "h": 214,
   "kind": "ok",
   "title": "Lower the pressure",
   "lines": [
    "• the ONLY treatment",
    "• drops → laser → surgery",
    "• same-day referral only if > 30"
   ]
  },
