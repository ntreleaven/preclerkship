 "nodes": [
  {
   "id": "root",
   "x": 431,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "A child's eyes: acuity in EACH eye, alignment, red reflex",
   "lines": [
    "anything that blurs, blocks or misaligns one eye while vision develops → AMBLYOPIA",
    "early detection and early treatment are what restore vision"
   ]
  },
  {
   "id": "g_rr",
   "x": 45,
   "y": 138,
   "w": 732,
   "h": 96,
   "kind": "plain",
   "title": "RED REFLEX (Brückner): both eyes at once",
   "lines": [
    "dim room · 1/3 m or more · child looking far away",
    "compare brightness, colour, alignment, symmetry",
    "~disease in both eyes is easy to miss if they match"
   ]
  },
  {
   "id": "g_al",
   "x": 817,
   "y": 138,
   "w": 484,
   "h": 96,
   "kind": "plain",
   "title": "MISALIGNED: does the angle change with gaze?",
   "lines": [
    "corneal light reflexes · cover test (from 6-7 months) · cardinal gazes"
   ]
  },
  {
   "id": "g_am",
   "x": 1341,
   "y": 138,
   "w": 236,
   "h": 96,
   "kind": "plain",
   "title": "ACUITY ↓ in one eye",
   "lines": [
    "no eye disease to explain it"
   ]
  },
  {
