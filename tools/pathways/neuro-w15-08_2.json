   "w": 236,
   "h": 60,
   "kind": "white_h",
   "title": "Leukocoria",
   "lines": [
    "a WHITE pupillary reflex"
   ]
  },
  {
   "id": "con_head_0_0",
   "x": 817,
   "y": 314,
   "w": 236,
   "h": 60,
   "kind": "con_h",
   "title": "Concomitant strabismus",
   "lines": [
    "non-paralytic"
   ]
  },
  {
   "id": "inc_head_0_0",
   "x": 1065,
   "y": 314,
   "w": 236,
   "h": 60,
   "kind": "inc_h",
   "title": "Incomitant strabismus",
   "lines": [
    "paralytic or restrictive"
   ]
  },
  {
   "id": "amb_head_0_0",
   "x": 1341,
   "y": 314,
   "w": 236,
   "h": 60,
   "kind": "amb_h",
   "title": "Amblyopia",
   "lines": [
    "usually one eye"
   ]
  },
  {
   "id": "dim_pres_0_0",
   "x": 45,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "dim_t",
   "title": "One reflex DIMMER",
   "lines": [
    "• or a visible opacity in it",
    "• the eye with the larger refractive error is dimmer"
   ]
  },
  {
   "id": "bright_pres_0_0",
   "x": 293,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "bright_t",
   "title": "One reflex BRIGHTER",
   "lines": [
    "• its pupil looks slightly larger",
    "• finds turns as small as 3 prism dioptres"
   ]
  },
  {
   "id": "white_pres_0_0",
   "x": 541,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "white_t",
   "title": "White reflex",
   "lines": [
    "• may be the first sign of a life-threatening disease",
    "~physiologic white reflex ~15° off axis: still refer"
   ]
  },
  {
   "id": "con_pres_0_0",
   "x": 817,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "con_t",
   "title": "SAME angle in every gaze",
   "lines": [
    "• muscles work, eyes not aimed together",
    "• starts in childhood"
   ]
  },
  {
   "id": "inc_pres_0_0",
   "x": 1065,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "inc_t",
   "title": "Angle CHANGES with gaze",
   "lines": [
    "a muscle or nerve not working, or tethered"
   ]
  },
  {
   "id": "amb_pres_0_0",
   "x": 1341,
   "y": 414,
   "w": 236,
   "h": 132,
   "kind": "amb_t",
   "title": "Test EACH eye",
   "lines": [
    "• newborn: light reflexes, pupils, fundus",
    "• to age 2: fusses when the GOOD eye is covered",
    "• 2-5: HOTV, tumbling E charts"
   ]
  },
  {
   "id": "dim_inv_0_0",
   "x": 45,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "dim_w",
   "title": "Refractive error or opacity",
   "lines": [
    "• myopia, hyperopia, astigmatism",
    "• cataract (not always white)",
    "• cornea, chamber, vitreous, retina"
   ]
  },
  {
   "id": "bright_inv_0_0",
   "x": 293,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "bright_w",
   "title": "Strabismus",
   "lines": [
    "the BRIGHTER eye is the turned eye"
   ]
  },
  {
   "id": "white_inv_0_0",
   "x": 541,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "white_w",
   "title": "RETINOBLASTOMA first",
   "lines": [
    "• retinopathy of prematurity",
    "• congenital cataract",
    "• Coats' disease, toxocariasis, coloboma"
   ]
  },
  {
   "id": "con_inv_0_0",
   "x": 817,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "con_w",
   "title": "Name the direction",
   "lines": [
    "• eso- in · exo- out",
    "• hyper- up · hypo- down",
    "~epicanthal folds: pseudostrabismus"
   ]
  },
  {
   "id": "inc_inv_0_0",
   "x": 1065,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "inc_w",
   "title": "Look for",
   "lines": [
    "• 3rd, 4th or 6th nerve palsy",
    "• orbital blowout fracture",
    "• thyroid eye disease"
   ]
  },
  {
   "id": "amb_inv_0_0",
   "x": 1341,
   "y": 586,
   "w": 236,
   "h": 114,
   "kind": "amb_w",
   "title": "Three causes",
   "lines": [
    "• strabismic: turned eye suppressed",
    "• refractive: unequal refractive error",
    "• deprivation: cataract, corneal scar, ptosis"
   ]
  },
  {
   "id": "dim_tx_0_0",
   "x": 45,
   "y": 740,
   "w": 236,
   "h": 178,
   "kind": "warn",
   "title": "Timely referral",
   "lines": [
    "amblyopia risk"
   ]
  },
  {
   "id": "bright_tx_0_0",
   "x": 293,
   "y": 740,
   "w": 236,
   "h": 178,
   "kind": "warn",
   "title": "Refer",
   "lines": [
    "amblyopia risk in the turned eye"
   ]
  },
  {
   "id": "white_tx_0_0",
   "x": 541,
   "y": 740,
   "w": 236,
   "h": 178,
   "kind": "bad",
   "title": "IMMEDIATE referral",
   "lines": [
    "• family history of eye disease",
    "• bring old photographs",
    "~without needless alarm"
   ]
  },
  {
   "id": "con_tx_0_0",
   "x": 817,
   "y": 740,
   "w": 236,
   "h": 96,
   "kind": "warn",
   "title": "Refer if",
   "lines": [
    "• constant turn at any age",
    "• occasional turn beyond 3-4 months",
    "• any nystagmus"
   ]
  },
  {
   "id": "con_tx_1_0",
   "x": 817,
   "y": 858,
   "w": 236,
   "h": 60,
   "kind": "ok",
   "title": "Patching, glasses, surgery",
   "lines": [
    "no role for eye exercises"
   ]
  },
  {
   "id": "inc_tx_0_0",
   "x": 1065,
   "y": 740,
   "w": 236,
   "h": 178,
   "kind": "warn",
   "title": "Refer to ophthalmology",
   "lines": []
  },
  {
   "id": "amb_tx_0_0",
   "x": 1341,
   "y": 740,
   "w": 236,
   "h": 69,
   "kind": "bad",
   "title": "IMMEDIATE referral",
   "lines": [
    "pediatric ophthalmologist"
   ]
  },
  {
   "id": "amb_tx_1_0",
