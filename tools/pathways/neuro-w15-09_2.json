 "nodes": [
  {
   "id": "root",
   "x": 324,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "Hearing loss: is sound BLOCKED before the cochlea, or is the cochlea or nerve DAMAGED?",
   "lines": [
    "512 Hz tuning forks, ALWAYS both: Weber on the midline (where is it loudest?) + Rinne (mastoid, then beside the ear)",
    "a SUDDEN conductive loss can wait; a SUDDEN sensorineural loss is an EMERGENCY"
   ]
  },
  {
   "id": "g_c",
   "x": 45,
   "y": 138,
   "w": 639,
   "h": 96,
   "kind": "plain",
   "title": "CONDUCTIVE",
   "lines": [
    "Weber → the AFFECTED ear · Rinne there: bone > air",
    "audiogram: bone normal, air down (an air-bone gap)",
    "often fixable, medically or surgically"
   ]
  },
  {
   "id": "g_s",
   "x": 724,
   "y": 138,
   "w": 639,
   "h": 96,
   "kind": "plain",
   "title": "SENSORINEURAL",
   "lines": [
    "Weber → the NORMAL ear · Rinne: air > bone",
    "audiogram: bone down, air the same as bone",
    "damage to cochlea or nerve cannot be repaired"
   ]
  },
  {
   "id": "eac_head_0_0",
   "x": 45,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "eac_h",
   "title": "Ear canal",
   "lines": [
    "wax · foreign body · exostoses · otitis externa"
   ]
  },
  {
   "id": "om_head_0_0",
   "x": 262,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "om_h",
   "title": "Otitis media",
   "lines": [
    "the commonest middle ear cause"
   ]
  },
  {
   "id": "fix_head_0_0",
   "x": 479,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "fix_h",
   "title": "Drum or ossicles",
   "lines": [
    "perforation · otosclerosis · longitudinal fracture"
   ]
  },
  {
   "id": "ssnhl_head_0_0",
   "x": 724,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "ssnhl_h",
   "title": "SUDDEN sensorineural",
   "lines": [
    "onset < 3 days · EMERGENCY"
   ]
  },
  {
   "id": "grad_head_0_0",
   "x": 941,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "grad_h",
   "title": "Gradual, symmetric",
   "lines": [
    "presbycusis · noise · ototoxic drugs"
   ]
  },
  {
   "id": "vs_head_0_0",
   "x": 1158,
   "y": 314,
   "w": 205,
   "h": 78,
   "kind": "vs_h",
   "title": "ONE-sided, progressive",
   "lines": [
    "vestibular schwannoma (acoustic neuroma)"
   ]
  },
  {
   "id": "eac_pres_0_0",
   "x": 45,
   "y": 432,
   "w": 205,
   "h": 216,
   "kind": "eac_t",
   "title": "Otitis externa",
   "lines": [
    "• bacterial: itchy, painful, swollen, sore on pulling the pinna",
    "• fungal: severe itch, less pain, after antibiotics",
    "~fungal and recurrent → think diabetes"
   ]
  },
  {
   "id": "om_pres_0_0",
   "x": 262,
   "y": 432,
   "w": 205,
   "h": 96,
   "kind": "om_t",
   "title": "Acute: after a cold",
   "lines": [
    "pain, fever, irritability · bulging drum",
    "~overdiagnosed"
   ]
  },
  {
   "id": "om_pres_1_0",
   "x": 262,
   "y": 550,
   "w": 205,
   "h": 98,
   "kind": "om_w",
   "title": "With effusion: no infection signs",
   "lines": [
    "hearing loss, speech delay",
    "~underdiagnosed"
   ]
  },
  {
   "id": "fix_pres_0_0",
   "x": 479,
   "y": 432,
   "w": 205,
   "h": 216,
   "kind": "fix_t",
   "title": "Which one?",
   "lines": [
    "• perforation: infection, tubes, trauma, barotrauma",
    "• otosclerosis: NORMAL drum, no trauma or infection",
    "• fracture (80%, side blow): unconscious, bleeding from or behind the drum"
   ]
  },
  {
   "id": "ssnhl_pres_0_0",
   "x": 724,
   "y": 432,
   "w": 205,
   "h": 216,
   "kind": "ssnhl_t",
   "title": "Hearing loss, tinnitus, fullness",
   "lines": [
    "± vertigo",
    "~mostly idiopathic"
   ]
  },
  {
   "id": "grad_pres_0_0",
   "x": 941,
   "y": 432,
   "w": 205,
   "h": 216,
   "kind": "grad_t",
   "title": "Which one?",
   "lines": [
    "• presbycusis: commonest, HIGH pitches first, 30% over 65, 50% over 75",
    "• noise > 85 dB: work, guns (asymmetric)",
    "• aminoglycosides, cisplatin, carboplatin, vincristine, loop diuretics",
    "~ASA and quinine: reversible"
   ]
  },
  {
   "id": "vs_pres_0_0",
   "x": 1158,
   "y": 432,
   "w": 205,
   "h": 216,
   "kind": "vs_t",
   "title": "Unilateral loss + tinnitus",
   "lines": [
    "• imbalance (rarely vertigo)",
    "• trigeminal or facial nerve symptoms",
    "~commonest cerebellopontine angle mass · both sides = NF2"
   ]
  },
  {
   "id": "eac_inv_0_0",
   "x": 45,
   "y": 688,
   "w": 205,
   "h": 180,
   "kind": "eac_w",
   "title": "Otoscopy",
   "lines": [
    "• bacterial: Pseudomonas, then Staph aureus",
    "• fungal: black spores (Aspergillus), white (Candida)"
   ]
  },
  {
   "id": "om_inv_0_0",
   "x": 262,
   "y": 688,
   "w": 205,
   "h": 60,
   "kind": "om_w",
   "title": "Pneumatic otoscopy",
   "lines": [
    "drum does not move = fluid"
   ]
  },
  {
   "id": "om_inv_1_0",
   "x": 262,
   "y": 770,
   "w": 205,
   "h": 98,
   "kind": "om_w",
   "title": "Fluid in BOTH ears for 3 months",
   "lines": [
    "→ hearing test (speech, development)"
   ]
  },
  {
   "id": "fix_inv_0_0",
   "x": 479,
   "y": 688,
   "w": 205,
   "h": 88,
   "kind": "fix_w",
   "title": "Audiogram",
   "lines": [
    "otosclerosis: conductive or mixed, Carhart's notch"
   ]
  },
  {
   "id": "fix_inv_1_0",
   "x": 479,
   "y": 798,
   "w": 205,
   "h": 70,
   "kind": "fix_w",
   "title": "CT",
   "lines": [
    "bone and ossicles"
   ]
  },
  {
   "id": "ssnhl_inv_0_0",
   "x": 724,
   "y": 688,
   "w": 205,
   "h": 180,
   "kind": "ssnhl_w",
   "title": "Workup",
   "lines": [
    "1 · tuning forks",
    "2 · ENT referral",
    "3 · audiogram",
    "4 · MRI: 2% are an acoustic neuroma"
   ]
  },
  {
   "id": "grad_inv_0_0",
   "x": 941,
   "y": 688,
   "w": 205,
   "h": 180,
   "kind": "grad_w",
   "title": "Audiogram",
   "lines": [
    "• presbycusis: high-frequency loss",
    "• noise: a 4,000 Hz NOTCH"
   ]
  },
  {
   "id": "vs_inv_0_0",
   "x": 1158,
   "y": 688,
   "w": 205,
   "h": 180,
   "kind": "vs_w",
   "title": "MRI ± gadolinium",
   "lines": [
    "soft tissue, cerebellopontine angle tumours"
   ]
  },
  {
   "id": "eac_tx_0_0",
   "x": 45,
   "y": 908,
   "w": 205,
   "h": 123,
   "kind": "ok",
   "title": "Clean it",
   "lines": [
    "• debride, acidify, stop Q-tips",
    "• antibiotic + steroid drops",
    "• fungal: antifungal drops"
   ]
  },
  {
   "id": "eac_tx_1_0",
   "x": 45,
   "y": 1053,
   "w": 205,
   "h": 125,
   "kind": "bad",
   "title": "Perforation? NO ototoxic drops",
   "lines": [
    "ciprofloxacin + dexamethasone is non-ototoxic"
   ]
  },
  {
   "id": "om_tx_0_0",
   "x": 262,
   "y": 908,
   "w": 205,
   "h": 98,
   "kind": "ok",
   "title": "Acute: high-dose amoxicillin",
   "lines": [
    "or watch 48-72 h in lower-risk children · treat pain"
   ]
  },
  {
   "id": "om_tx_1_0",
   "x": 262,
   "y": 1028,
   "w": 205,
   "h": 150,
   "kind": "warn",
   "title": "Tubes",
   "lines": [
    "• effusion both ears > 3 months + > 20 dB loss in the better ear",
    "• fluid with speech delay",
    "• symptoms despite > 6 weeks of antibiotics"
   ]
  },
  {
   "id": "fix_tx_0_0",
   "x": 479,
   "y": 908,
   "w": 205,
   "h": 270,
   "kind": "ok",
   "title": "Fix or bypass",
   "lines": [
    "• perforation: keep dry, 80% heal; else tympanoplasty",
    "• ossiculoplasty · stapedectomy",
    "• aids: air, or bone-conduction (implanted)"
   ]
  },
  {
   "id": "ssnhl_tx_0_0",
   "x": 724,
   "y": 908,
   "w": 205,
   "h": 270,
   "kind": "ok",
   "title": "Steroids by mouth or into the ear",
   "lines": [
    "START WITHIN 10 DAYS",
    "~60-80% recover"
   ]
  },
  {
   "id": "grad_tx_0_0",
   "x": 941,
   "y": 908,
   "w": 205,
   "h": 123,
   "kind": "ok",
   "title": "Protect, then amplify",
   "lines": [
    "• hearing protection",
    "• hearing aid: volume, NOT clarity"
   ]
  },
  {
   "id": "grad_tx_1_0",
   "x": 941,
   "y": 1053,
   "w": 205,
   "h": 125,
   "kind": "ok",
   "title": "Severe to profound, aids failing",
   "lines": [
    "cochlear implant (needs a working nerve)"
   ]
  },
  {
   "id": "vs_tx_0_0",
   "x": 1158,
   "y": 908,
   "w": 205,
   "h": 270,
   "kind": "ok",
   "title": "Slow, benign",
   "lines": [
    "observe · stereotactic radiation · microsurgery"
   ]
  }
 ],
