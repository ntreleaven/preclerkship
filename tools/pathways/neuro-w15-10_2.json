 "nodes": [
  {
   "id": "root",
   "x": 297,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "\"Dizzy\": is it TRUE VERTIGO, an illusion of rotary movement?",
   "lines": [
    "history is 80% of the workup · exam: nystagmus (named by its FAST phase) and ataxia"
   ]
  },
  {
   "id": "g_not",
   "x": 45,
   "y": 120,
   "w": 196,
   "h": 78,
   "kind": "plain",
   "title": "NO: dizziness",
   "lines": [
    "lightheaded, unsteady, disoriented · chronic"
   ]
  },
  {
   "id": "g_v",
   "x": 281,
   "y": 120,
   "w": 1028,
   "h": 78,
   "kind": "plain",
   "title": "YES: vestibular",
   "lines": [
    "episodic, limited duration · hearing symptoms · nausea, vomiting, sweating · worse with head movement"
   ]
  },
  {
   "id": "t1",
   "x": 281,
   "y": 238,
   "w": 1028,
   "h": 78,
   "kind": "plain",
   "title": "How long does an attack last, and is hearing lost?",
   "lines": [
    "seconds: BPPV, dehiscence · minutes to hours: Ménière's (hearing lost) or migrainous (hearing kept) · days: labyrinthitis (hearing lost) or neuronitis (kept) · forever: uncompensated vestibular loss"
   ]
  },
  {
   "id": "diz_head_0_0",
   "x": 45,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "diz_h",
   "title": "Not vestibular",
   "lines": []
  },
  {
   "id": "bppv_head_0_0",
   "x": 281,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "bppv_h",
   "title": "BPPV",
   "lines": [
    "benign paroxysmal positional vertigo · commonest end-organ disorder"
   ]
  },
  {
   "id": "scd_head_0_0",
   "x": 489,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "scd_h",
   "title": "Superior canal dehiscence",
   "lines": [
    "a third mobile window into the inner ear"
   ]
  },
  {
   "id": "men_head_0_0",
   "x": 697,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "men_h",
   "title": "Ménière's disease",
   "lines": [
    "endolymphatic hydrops · 2nd commonest"
   ]
  },
  {
   "id": "neu_head_0_0",
   "x": 905,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "neu_h",
   "title": "Vestibular neuronitis / labyrinthitis",
   "lines": [
    "viral, often after a cold"
   ]
  },
  {
   "id": "ami_head_0_0",
   "x": 1113,
   "y": 396,
   "w": 196,
   "h": 98,
   "kind": "ami_h",
   "title": "Aminoglycoside toxicity",
   "lines": [
    "ear drops or injections"
   ]
  },
  {
   "id": "diz_pres_0_0",
   "x": 45,
   "y": 534,
   "w": 196,
   "h": 168,
   "kind": "diz_t",
   "title": "Organic",
   "lines": [
    "• presyncope, vasodepressor syncope",
    "• arrhythmia",
    "• orthostatic hypotension",
    "• hyperventilation · anemia",
    "• neuropathy · poor vision",
    "• musculoskeletal · drugs"
   ]
  },
  {
   "id": "diz_pres_1_0",
   "x": 45,
   "y": 724,
   "w": 196,
   "h": 114,
   "kind": "diz_w",
   "title": "Psychiatric",
   "lines": [
    "• depression · anxiety",
    "• panic disorder",
    "• phobic dizziness · somatization"
   ]
  },
  {
   "id": "bppv_pres_0_0",
   "x": 281,
   "y": 534,
   "w": 196,
   "h": 304,
   "kind": "bppv_t",
   "title": "10-30 s of spinning",
   "lines": [
    "• set off by specific head movements",
    "• hearing NORMAL",
    "~idiopathic, or head trauma"
   ]
  },
  {
   "id": "scd_pres_0_0",
   "x": 489,
   "y": 534,
   "w": 196,
   "h": 304,
   "kind": "scd_t",
   "title": "Vertigo with LOUD SOUND or PRESSURE",
   "lines": [
    "• hears own voice, footsteps, eye movements",
    "• conductive loss, acoustic reflexes PRESERVED"
   ]
  },
  {
   "id": "men_pres_0_0",
   "x": 697,
   "y": 534,
   "w": 196,
   "h": 304,
   "kind": "men_t",
   "title": "Episodic vertigo, 24 min to 24 h",
   "lines": [
    "• FLUCTUATING LOW-frequency sensorineural loss",
    "• tinnitus · aural fullness",
    "~both ears in 25-30%"
   ]
  },
  {
   "id": "neu_pres_0_0",
   "x": 905,
   "y": 534,
   "w": 196,
   "h": 304,
   "kind": "neu_t",
   "title": "Vertigo for DAYS",
   "lines": [
    "• nausea, vomiting",
    "• nystagmus beats AWAY from the bad ear"
   ]
  },
  {
   "id": "ami_pres_0_0",
   "x": 1113,
   "y": 534,
   "w": 196,
   "h": 141,
   "kind": "ami_t",
   "title": "One ear (drops)",
   "lines": [
    "vertigo, nystagmus beating away from it"
   ]
  },
  {
   "id": "ami_pres_1_0",
   "x": 1113,
   "y": 697,
   "w": 196,
   "h": 141,
   "kind": "ami_w",
   "title": "Systemic (both ears)",
   "lines": [
    "severe disequilibrium, motion sensitivity, oscillopsia"
   ]
  },
  {
   "id": "diz_inv_0_0",
   "x": 45,
   "y": 878,
   "w": 196,
   "h": 146,
   "kind": "diz_w",
   "title": "Look for",
   "lines": [
    "cardiac or neurological symptoms, loss of consciousness"
   ]
  },
  {
   "id": "bppv_inv_0_0",
   "x": 281,
   "y": 878,
   "w": 196,
   "h": 146,
   "kind": "bppv_w",
   "title": "Dix-Hallpike",
   "lines": [
    "torsional nystagmus with latency, fades, reverses on sitting up"
   ]
  },
  {
   "id": "scd_inv_0_0",
   "x": 489,
   "y": 878,
   "w": 196,
   "h": 146,
   "kind": "scd_w",
   "title": "Audiometry + temporal bone CT",
   "lines": []
  },
  {
   "id": "men_inv_0_0",
   "x": 697,
   "y": 878,
   "w": 196,
   "h": 146,
   "kind": "men_w",
   "title": "Ménière's syndrome?",
   "lines": [
    "secondary: syphilis, trauma, labyrinthitis"
   ]
  },
  {
   "id": "neu_inv_0_0",
   "x": 905,
   "y": 878,
   "w": 196,
   "h": 62,
   "kind": "neu_w",
   "title": "Hearing kept → NEURONITIS",
   "lines": []
  },
  {
   "id": "neu_inv_1_0",
   "x": 905,
   "y": 962,
   "w": 196,
   "h": 62,
   "kind": "neu_w",
   "title": "Hearing loss + tinnitus → LABYRINTHITIS",
   "lines": []
  },
  {
   "id": "ami_inv_0_0",
   "x": 1113,
   "y": 878,
   "w": 196,
   "h": 146,
   "kind": "ami_w",
   "title": "Usually diagnosed 'after the fact'",
   "lines": []
  },
  {
   "id": "diz_tx_0_0",
   "x": 45,
   "y": 1064,
   "w": 196,
   "h": 380,
   "kind": "diz_w",
   "title": "Not a vestibular problem",
   "lines": [
    "~chronic disequilibrium, lightheadedness"
   ]
  },
  {
   "id": "bppv_tx_0_0",
   "x": 281,
   "y": 1064,
   "w": 196,
   "h": 380,
   "kind": "ok",
   "title": "Particle repositioning (Epley, Semont)",
   "lines": [
    "80% after 1 session · 95% after 3",
    "~intractable: posterior canal occlusion"
   ]
  },
  {
   "id": "scd_tx_0_0",
   "x": 489,
   "y": 1064,
   "w": 196,
   "h": 380,
   "kind": "ok",
   "title": "Avoid triggers, or surgery",
   "lines": []
  },
  {
   "id": "men_tx_0_0",
   "x": 697,
   "y": 1064,
   "w": 196,
   "h": 98,
   "kind": "ok",
   "title": "1 · Everyone, 3-6 months",
   "lines": [
    "low salt · no caffeine, chocolate, alcohol, tobacco"
   ]
  },
  {
   "id": "men_tx_1_0",
   "x": 697,
   "y": 1184,
   "w": 196,
   "h": 78,
   "kind": "ok",
   "title": "2 · Attacks",
   "lines": [
    "vestibular suppressant · diuretic · betahistine"
   ]
  },
  {
   "id": "men_tx_2_0",
   "x": 697,
   "y": 1284,
   "w": 196,
   "h": 60,
   "kind": "warn",
   "title": "3 · Failing: into the ear",
   "lines": [
    "steroids → gentamicin"
   ]
  },
  {
   "id": "men_tx_3_0",
   "x": 697,
   "y": 1366,
   "w": 196,
   "h": 78,
   "kind": "bad",
   "title": "4 · Last: surgery",
   "lines": [
    "vestibular neurectomy → labyrinthectomy"
   ]
  },
  {
   "id": "neu_tx_0_0",
   "x": 905,
   "y": 1064,
   "w": 196,
   "h": 380,
   "kind": "ok",
   "title": "Symptoms, short-term",
   "lines": [
    "• antiemetics, vestibular sedatives",
    "• oral steroids if within 72 h",
    "~antivirals: no evidence"
   ]
  },
  {
   "id": "ami_tx_0_0",
   "x": 1113,
   "y": 1064,
   "w": 196,
   "h": 380,
   "kind": "bad",
   "title": "STOP the aminoglycoside",
   "lines": [
    "~usually permanent, some partial recovery"
   ]
  }
 ],
