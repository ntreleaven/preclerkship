   "title": "Multiple cardioembolic strokes",
   "lines": [
    "atrial fibrillation · endocarditis (infective, cancer, Libman-Sacks) · cardiac tumours"
   ]
  },
  {
   "id": "onc_pres_0_0",
   "x": 45,
   "y": 434,
   "w": 215,
   "h": 258,
   "kind": "onc_t",
   "title": "Which mechanism?",
   "lines": [
    "• compression: cord, root, nerve",
    "• invasion: nerve, plexus, brain, cord",
    "• paraneoplastic antibodies: limbic encephalitis, dermatomyositis, myasthenia gravis, cerebellitis",
    "• treatment toxicity: chemotherapy, radiation, surgery",
    "• CHECKPOINT INHIBITOR autoimmunity"
   ]
  },
  {
   "id": "onc_pres_1_0",
   "x": 45,
   "y": 714,
   "w": 215,
   "h": 116,
   "kind": "onc_w",
   "title": "Checkpoint inhibitor (ipilimumab, nivolumab)",
   "lines": [
    "ptosis, neck and proximal weakness, normal reflexes and sensation"
   ]
  },
  {
   "id": "phr_pres_0_0",
   "x": 300,
   "y": 434,
   "w": 215,
   "h": 396,
   "kind": "phr_t",
   "title": "Dyspnea WORSE LYING DOWN",
   "lines": [
    "• sleeps upright in a chair",
    "• normal heart, chest, limbs, cranial nerves",
    "~lying down the diaphragm does the work; upright, the intercostals"
   ]
  },
  {
   "id": "wer_pres_0_0",
   "x": 555,
   "y": 434,
   "w": 215,
   "h": 396,
   "kind": "wer_t",
   "title": "Triad",
   "lines": [
    "• ataxia",
    "• ophthalmoplegia (e.g. both 6th nerves)",
    "• confusion",
    "~poor intake, then REFEEDING without thiamine"
   ]
  },
  {
   "id": "nut_pres_0_0",
   "x": 782,
   "y": 434,
   "w": 215,
   "h": 396,
   "kind": "nut_t",
   "title": "Deficiency or excess",
   "lines": [
    "• B1: dry beriberi = neuropathy · wet = cardiomyopathy",
    "• B12: subacute combined degeneration",
    "• copper (after bariatric surgery): myelopathy",
    "• B6 EXCESS: sensory neuropathy"
   ]
  },
  {
   "id": "ce_pres_0_0",
   "x": 1037,
   "y": 434,
   "w": 215,
   "h": 198,
   "kind": "ce_t",
   "title": "Deficits in SEVERAL territories, ACUTE and STEPWISE",
   "lines": [
    "~subacute, slowly progressive → metastases or abscesses",
    "~else: vasculitis · tumours · abscesses · demyelination"
   ]
  },
  {
   "id": "ce_pres_1_0",
   "x": 1037,
   "y": 654,
   "w": 215,
   "h": 176,
   "kind": "ce_w",
   "title": "Endocarditis?",
   "lines": [
    "• fever, tachycardia",
    "• murmur",
    "• splinter hemorrhages, Janeway lesions, Osler nodes, Roth spots"
   ]
  },
  {
   "id": "onc_inv_0_0",
   "x": 45,
   "y": 870,
   "w": 215,
   "h": 224,
   "kind": "onc_w",
   "title": "Junction or muscle?",
   "lines": [
    "• CK",
    "• acetylcholine receptor antibody",
    "• EMG / nerve conduction studies"
   ]
  },
  {
   "id": "phr_inv_0_0",
   "x": 300,
   "y": 870,
   "w": 215,
   "h": 224,
   "kind": "phr_w",
   "title": "Confirm and find the cause",
   "lines": [
    "1 · chest X-ray",
    "2 · diaphragm fluoroscopy in and out",
    "3 · lung function seated vs supine",
    "4 · phrenic nerve conduction studies",
    "5 · image the neck and mediastinum"
   ]
  },
  {
   "id": "wer_inv_0_0",
   "x": 555,
   "y": 870,
   "w": 215,
   "h": 224,
   "kind": "wer_w",
   "title": "Will not localize to one place",
   "lines": [
    "global dysfunction + strong pons involvement"
   ]
  },
  {
   "id": "nut_inv_0_0",
   "x": 782,
   "y": 870,
   "w": 215,
   "h": 224,
   "kind": "bad",
   "title": "Refeeding syndrome",
   "lines": [
    "after long starvation, electrolytes shift into cells: ↓ sodium, potassium, calcium, magnesium, phosphate",
    "→ confusion → weakness → seizures, arrhythmias"
   ]
  },
  {
   "id": "ce_inv_0_0",
   "x": 1037,
   "y": 870,
   "w": 215,
   "h": 224,
   "kind": "ce_w",
   "title": "Suspected endocarditis",
   "lines": [
    "1 · blood cultures × 2 (keep for HACEK)",
    "2 · transthoracic ± transesophageal echo",
    "3 · find the source (dental)",
    "~cultures negative → non-bacterial endocarditis of cancer"
   ]
  },
  {
   "id": "onc_tx_0_0",
   "x": 45,
   "y": 1134,
   "w": 215,
   "h": 170,
   "kind": "ok",
   "title": "With oncology: STOP the inhibitor and/or STEROIDS",
   "lines": [
    "~steroids may blunt the tumour treatment"
   ]
  },
  {
   "id": "phr_tx_0_0",
   "x": 300,
   "y": 1134,
   "w": 215,
   "h": 170,
   "kind": "phr_w",
   "title": "Other levels of breathing weakness",
   "lines": [
    "• muscle: myopathies",
    "• junction: myasthenia gravis",
    "• nerve: Guillain-Barré",
    "• roots: multilevel C3-5",
    "• anterior horn: ALS",
    "• cord: high cervical myelopathy"
   ]
  },
  {
   "id": "wer_tx_0_0",
   "x": 555,
   "y": 1134,
   "w": 215,
   "h": 170,
   "kind": "ok",
   "title": "THIAMINE",
   "lines": [
    "give it BEFORE glucose if nutrition is in doubt"
   ]
  },
  {
   "id": "nut_tx_0_0",
   "x": 782,
   "y": 1134,
   "w": 215,
   "h": 170,
   "kind": "ok",
   "title": "Refeed SLOWLY",
   "lines": [
    "check electrolytes often"
   ]
  },
  {
   "id": "ce_tx_0_0",
   "x": 1037,
   "y": 1134,
   "w": 215,
   "h": 170,
   "kind": "bad",
   "title": "NO tPA",
   "lines": [
    "~cultures and echo instead"
   ]
  }
