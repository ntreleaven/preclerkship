 "nodes": [
  {
   "id": "root",
   "x": 161,
   "y": 10,
   "w": 760,
   "kind": "dark",
   "title": "End of life: who decides, and what can be offered?",
   "lines": [
    "capacity = UNDERSTAND the information + APPRECIATE the foreseeable consequences · specific to each decision · can fluctuate",
    "code status (which resuscitation, if any) needs informed consent from the patient or SDM · it is NOT the same as goals of care"
   ]
  },
  {
   "id": "g_cap",
   "x": 45,
   "y": 156,
   "w": 225,
   "h": 60,
   "kind": "plain",
   "title": "Patient NOT capable",
   "lines": [
    "of this decision"
   ]
  },
  {
   "id": "g_pal",
   "x": 310,
   "y": 156,
   "w": 225,
   "h": 60,
   "kind": "plain",
   "title": "Comfort becomes the goal",
   "lines": []
  },
  {
   "id": "g_maid",
   "x": 575,
   "y": 156,
   "w": 462,
   "h": 60,
   "kind": "plain",
   "title": "Patient asks for medical assistance in dying (MAiD)",
   "lines": []
  },
  {
   "id": "p_maid",
   "x": 575,
   "y": 256,
   "w": 462,
   "h": 150,
   "kind": "info",
   "title": "Eligible? ALL of these",
   "lines": [
    "• eligible for publicly funded health care",
    "• 18 or older and capable",
    "• grievous and irremediable: serious illness, advanced irreversible decline, unbearable suffering",
    "• voluntary, free of outside pressure",
    "• informed consent, including palliative options"
   ]
  },
  {
   "id": "sdm_head_0_0",
   "x": 45,
   "y": 486,
   "w": 225,
   "h": 98,
   "kind": "sdm_h",
   "title": "Substitute decision maker (SDM)",
   "lines": [
    "gives or refuses consent for the patient"
   ]
  },
  {
   "id": "pal_head_0_0",
   "x": 310,
   "y": 486,
   "w": 225,
   "h": 98,
   "kind": "pal_h",
   "title": "Palliative care",
   "lines": [
    "quality of life: physical, psychosocial, spiritual · patient AND family"
   ]
  },
  {
   "id": "s1_head_0_0",
   "x": 575,
   "y": 486,
   "w": 225,
   "h": 98,
   "kind": "s1_h",
   "title": "Stream 1",
   "lines": [
    "natural death reasonably FORESEEABLE"
   ]
  },
  {
   "id": "s2_head_0_0",
   "x": 812,
   "y": 486,
   "w": 225,
   "h": 98,
   "kind": "s2_h",
   "title": "Stream 2",
   "lines": [
    "natural death NOT reasonably foreseeable"
   ]
  },
  {
   "id": "sdm_when_0_0",
   "x": 45,
   "y": 624,
   "w": 225,
   "h": 168,
   "kind": "sdm_t",
   "title": "Fails EITHER part of capacity",
   "lines": [
    "• cannot understand the information",
    "• cannot appreciate the consequences"
   ]
  },
  {
   "id": "pal_when_0_0",
   "x": 310,
   "y": 624,
   "w": 225,
   "h": 168,
   "kind": "pal_t",
   "title": "Any ONE route in",
   "lines": [
    "• patient declines treatment",
    "• treatment futile or would cause suffering",
    "• hard symptoms DURING treatment",
    "• severe irreversible disability (e.g. major stroke)"
   ]
  },
  {
   "id": "s1_when_0_0",
   "x": 575,
   "y": 624,
   "w": 225,
   "h": 168,
   "kind": "s1_t",
   "title": "Written request",
   "lines": [
    "signed before an independent witness"
   ]
  },
  {
   "id": "s2_when_0_0",
   "x": 812,
   "y": 624,
   "w": 225,
   "h": 168,
   "kind": "s2_t",
   "title": "Written request",
   "lines": [
    "signed before an independent witness"
   ]
  },
  {
   "id": "sdm_check_0_0",
   "x": 45,
   "y": 832,
   "w": 225,
   "h": 132,
   "kind": "sdm_w",
   "title": "Who assesses capacity?",
   "lines": [
    "the clinician offering the treatment",
    "~can be delegated"
   ]
  },
  {
   "id": "pal_check_0_0",
   "x": 310,
   "y": 832,
   "w": 225,
   "h": 132,
   "kind": "pal_w",
   "title": "Two scales",
   "lines": [
    "• Palliative Performance Scale: disease burden, progress to end of life",
    "• Edmonton Symptom Assessment System: symptoms to manage"
   ]
  },
  {
   "id": "s1_check_0_0",
   "x": 575,
   "y": 832,
   "w": 225,
   "h": 132,
   "kind": "s1_w",
   "title": "2 independent physicians or nurse practitioners",
   "lines": [
    "certify eligibility"
   ]
  },
  {
   "id": "s2_check_0_0",
   "x": 812,
   "y": 832,
   "w": 225,
   "h": 132,
   "kind": "s2_w",
   "title": "2 independent assessors",
   "lines": [
    "ONE has expertise in the condition and has discussed all treatment options"
   ]
  },
  {
   "id": "sdm_do_0_0",
   "x": 45,
   "y": 1004,
   "w": 225,
   "h": 260,
   "kind": "ok",
   "title": "Ask the SDM, in this ORDER",
   "lines": [
    "1 · court-ordered guardian",
    "2 · attorney for PERSONAL CARE (not property)",
    "3 · Consent and Capacity Board representative",
    "4 · spouse or partner",
    "5 · child (16+) or custodial parent",
    "6 · parent with right of access",
    "7 · siblings",
    "8 · any other relative",
    "9 · Public Guardian and Trustee"
   ]
  },
  {
   "id": "sdm_do_1_0",
   "x": 45,
   "y": 1286,
   "w": 225,
   "h": 78,
   "kind": "sdm_w",
   "title": "Advance care planning",
   "lines": [
    "WISHES that guide the SDM, NOT advance consent"
   ]
  },
  {
   "id": "pal_do_0_0",
   "x": 310,
   "y": 1004,
   "w": 225,
   "h": 360,
   "kind": "ok",
   "title": "Comfort, at home where possible",
   "lines": [
    "• control pain, breathlessness, delirium, agitation",
    "• stroke, disability unacceptable to them: no tube feeds or IV fluids",
    "• turning and symptom drugs do NOT hasten death"
   ]
  },
  {
   "id": "s1_do_0_0",
   "x": 575,
   "y": 1004,
   "w": 225,
   "h": 360,
   "kind": "ok",
   "title": "Consent AGAIN at the time of MAiD",
   "lines": [
    "unless a WAIVER of final consent was signed (at risk of losing capacity)"
   ]
  },
  {
   "id": "s2_do_0_0",
   "x": 812,
   "y": 1004,
   "w": 225,
   "h": 360,
   "kind": "bad",
   "title": "90-day wait · NO waiver",
   "lines": [
    "consent AGAIN at the time of MAiD"
   ]
  }
 ],
