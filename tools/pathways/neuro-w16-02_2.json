   "x": 677,
   "y": 432,
   "w": 290,
   "h": 152,
   "kind": "hosp_t",
   "title": "INFORMED authorization, in this ORDER",
   "lines": [
    "1 · estate trustee",
    "2 · spouse and adult children",
    "3 · parents",
    "4 · siblings",
    "5 · any other capable next of kin"
   ]
  },
